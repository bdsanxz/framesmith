#!/usr/bin/env bash
# Runs the quality gates before a push and stops the push when one fails.
# Installed by scripts/gates/install-hooks.sh; the behaviour is specified in docs/dev/gates.md, section 3.

# git gives one line for each ref to push: <local ref> <local sha> <remote ref> <remote sha>.
# A push that only deletes refs has nothing to check.
checking=0
while read -r _ local_sha _ _; do
    case "$local_sha" in
        *[!0]*) checking=1 ;;
    esac
done
if [ "$checking" -eq 0 ]; then
    exit 0
fi

root=$(git rev-parse --show-toplevel) || exit 1
if [ -n "$(git -C "$root" status --porcelain --untracked-files=no)" ]; then
    echo "pre-push: the working tree has uncommitted changes. The gates check the working tree, not the commits being pushed." >&2
fi

echo "pre-push: running the gates (scripts/gates.sh); a failing gate stops the push." >&2
"$root/scripts/gates.sh"
code=$?
if [ "$code" -eq 0 ]; then
    exit 0
fi
echo "pre-push: the gates did not pass (exit code $code). The push is stopped." >&2
exit 1
