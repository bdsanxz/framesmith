<?xml version="1.0" encoding="UTF-8"?>
<!-- Layers of a background, the first listed drawn on top. Left: half-clear red over blue, which shows through. Middle:
     opaque green over red, which is hidden. Right: a gradient from clear to opaque black over white. 330 by 120 pixels. -->
<composition version="1" id="background-layers" width="330" height="120" fps="30" duration="1" background="#808080">
  <box left="10" top="10" width="100" height="100" background="#ff000080, #0000ff"/>
  <box left="120" top="10" width="100" height="100" background="#00ff00, #ff0000"/>
  <box left="230" top="10" width="90" height="100" background="linear-gradient(90deg, #00000000 0%, #000000 100%), #ffffff"/>
</composition>
