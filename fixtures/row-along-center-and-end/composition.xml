<?xml version="1.0" encoding="UTF-8"?>
<!-- Two rows, each 96 wide and 10 tall, whose children are 10 by 10 with a gap of 4 pixels. The first row is centred
     along its direction: its group is 24 wide, so it starts 36 pixels in, at {36,0,10,10} and {50,0,10,10}. The
     second row sits at top 20 and is aligned to the end: its group starts 72 pixels in, at {72,20,10,10} and
     {86,20,10,10}. 96 by 54 pixels, 10 frames a second. -->
<composition version="1" id="row-along-center-and-end" width="96" height="54" fps="10" duration="1" background="#102040">
  <box id="centred" left="0" top="0" width="96" height="10" flex-direction="row" justify-content="center" gap="4">
    <box width="10" height="10" background="#ff8060"/>
    <box width="10" height="10" background="#80ff80"/>
  </box>
  <box id="at-end" left="0" top="20" width="96" height="10" flex-direction="row" justify-content="flex-end" gap="4">
    <box width="10" height="10" background="#ffd080"/>
    <box width="10" height="10" background="#80d0ff"/>
  </box>
</composition>
