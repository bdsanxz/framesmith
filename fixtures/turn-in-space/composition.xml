<?xml version="1.0" encoding="UTF-8"?>
<!-- Turns in space. Left: a blue square of 100 pixels with a perspective of 400, turned 60 degrees about the upright line
     through its middle: its right edge is further from the eye. Middle: the same square turned 45 degrees about the level
     line: its top edge is further. Right: a square with a red mark at its left turns about the upright line from 0 to 180
     degrees over 2 s with a perspective of 600: edge-on at 1 s (frame 30), drawn mirrored after, the mark on the right.
     400 by 200 pixels, 30 frames a second. -->
<composition version="1" id="turn-in-space" width="400" height="200" fps="30" duration="2" background="#ffffff">
  <box left="20" top="50" width="100" height="100" background="#2050c0" perspective="400" rotate-y="60"/>
  <box left="150" top="50" width="100" height="100" background="#2050c0" perspective="400" rotate-x="45"/>
  <box left="280" top="50" width="100" height="100" background="#20a040" perspective="600">
    <box left="0" top="40" width="20" height="20" background="#d03020"/>
    <tween duration="2" to-rotate-y="180"/>
  </box>
</composition>
