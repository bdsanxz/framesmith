<?xml version="1.0" encoding="UTF-8"?>
<!-- A brightness tweened to nothing, linearly. The box starts at brightness 1 and its brightness runs to 0 over the one
     second, so frame 15 has each colour halved. The ink is 40 by 64 pixels at left 16 on dark blue, in a 64 by 64 frame at 30
     frames a second. The values are in fixtures/blur-brightness-worked-values.md, section 4. -->
<composition version="1" id="brightness-tween-linear" width="64" height="64" fps="30" duration="1" background="#102040">
  <box left="16" top="0" width="40" height="64" background="#e0a030" brightness="1">
    <tween duration="1" to-brightness="0"/>
  </box>
</composition>
