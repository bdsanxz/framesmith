<?xml version="1.0" encoding="UTF-8"?>
<!-- Torn edges and grain. Left: an orange square of 50 pixels torn by 14 noise(0.035 3 9), its edge in and out by up to 7
     pixels, moving 18 pixels to the right over 0.9 s so that the noise moves with it (frame 9 is the square at x = 18). Right:
     a cream box with the grain noise(0.9 2 5) -1.7 1.75, its ink taken away where the noise is high. 160 by 100 pixels, 10
     frames a second. -->
<composition version="1" id="finishes-torn-and-grain" width="160" height="100" fps="10" duration="1" background="#1a2b3c">
  <box left="20" top="20" width="50" height="50" background="#e04020" displace="14 noise(0.035 3 9)">
    <tween duration="0.9" to-x="18"/>
  </box>
  <box left="100" top="20" width="40" height="60" background="#f0e8d0" grain="noise(0.9 2 5) -1.7 1.75"/>
</composition>
