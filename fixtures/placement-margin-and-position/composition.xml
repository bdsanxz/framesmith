<?xml version="1.0" encoding="UTF-8"?>
<!-- A margin moves an absolutely placed box in from each edge it is placed by, and no other box (render-command.md
     section 4.1, rule 8; notation.md N10). The first box, with no position, is at 10, 10 and is 20 by 20 with a margin
     of 8 4: it keeps its place, the columns 10 to 29 and the rows 10 to 29. The second, absolutely placed, is written
     at 50, 10 with a margin of 30: it lies at 80, 40, and the frame cuts it to the columns 80 to 95 and the rows 40 to
     53. The third, position="static" with four margins, keeps its place at 10, 40: the columns 10 to 29 and the rows
     40 to 49. 96 by 54 pixels, 10 frames a second. -->
<composition version="1" id="placement-margin-and-position" width="96" height="54" fps="10" duration="1" background="#102040">
  <box id="plain" left="10" top="10" width="20" height="20" margin="8 4" background="#e0a030"/>
  <box id="absolute" left="50" top="10" width="20" height="20" margin="30" position="absolute" background="#30c0a0"/>
  <box id="static" left="10" top="40" width="20" height="10" margin="1 2 3 4" position="static" background="#a050e0"/>
</composition>
