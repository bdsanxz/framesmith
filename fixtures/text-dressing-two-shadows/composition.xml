<?xml version="1.0" encoding="UTF-8"?>
<!-- A text in black with two shadows, listed in the order blue then red. The blue shadow is 6 pixels right and 4 down,
     the red one 2 pixels right and 2 down: where they overlap, the first listed, the blue, is on top. 200 by 90 pixels,
     10 frames a second. -->
<composition version="1" id="text-dressing-two-shadows" width="200" height="90" fps="10" duration="1" background="#ffffff">
  <font src="fonts/framesmith-test-stroke-400.ttf" family="Framesmith Test Stroke"/>
  <text left="10" top="8" font-family="Framesmith Test Stroke" font-size="30" text-shadow="6px 4px #2050c0, 2px 2px #c02020">HIIH</text>
</composition>
