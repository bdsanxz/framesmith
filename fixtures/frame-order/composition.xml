<?xml version="1.0" encoding="UTF-8"?>
<!-- The composition of the order proof: tweens, sets, eased motion, a text that moves and clips. 160 by 90 pixels, 30 frames
     a second for two seconds: 60 frames. The red box moves right with out-back(1.7) and is set back to the left at 1.5 s.
     The blue box turns and fades with in-out-sine over the whole length. The green clip shows from frame 20 to frame 44; the
     orange box inside it moves down with out-cubic from the clip's start. The purple clip shows from frame 36, at half its opacity
     from a set at 0.4 s, before it shows. The text moves left and grows with in-expo. -->
<composition version="1" id="frame-order" width="160" height="90" fps="30" duration="2" background="#ffffff">
  <font src="fonts/framesmith-test-stroke-400.ttf" family="Framesmith Test Stroke"/>
  <box left="4" top="4" width="16" height="16" background="#d03020">
    <tween duration="1.2" to-x="120" ease="out-back(1.7)"/>
    <set at="1.5" x="10"/>
  </box>
  <box left="70" top="28" width="20" height="20" background="#2050c0">
    <tween duration="2" to-rotation="90" to-opacity="0.3" ease="in-out-sine"/>
  </box>
  <box left="100" top="40" width="50" height="40" start="0.6667" duration="0.8" background="#20a040">
    <box left="5" top="2" width="10" height="10" background="#e08020">
      <tween duration="0.8" to-y="24" ease="out-cubic"/>
    </box>
  </box>
  <box left="10" top="56" width="24" height="24" start="1.2" duration="0.8" background="#8030a0">
    <set at="0.4" opacity="0.5"/>
  </box>
  <text left="40" top="60" font-family="Framesmith Test Stroke" font-size="16" color="#202020">HIIH<tween at="0.2" duration="1.6" to-x="-20" to-scale="1.3" ease="in-expo"/></text>
</composition>
