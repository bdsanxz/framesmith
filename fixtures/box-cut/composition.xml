<?xml version="1.0" encoding="UTF-8"?>
<!-- Children cut at their box. Left: a box with a border of 4 and a radius of 24 that cuts its children; a wide bar crosses
     it and runs past both sides, and a square sits in its rounded top left corner; the bar moves down from 0.5 s to 1.5 s.
     Middle: the same box with overflow visible, which shows the whole bar and the whole square. Right: a box that cuts, with a
     box inside it that cuts in turn, and a child of the inner box that runs past both. 320 by 180 pixels, 10 frames a second. -->
<composition version="1" id="box-cut" width="320" height="180" fps="10" duration="2" background="#203040">
  <box left="20" top="30" width="100" height="120" background="#f0e8d8" border="4 #c02020" border-radius="24" overflow="hidden">
    <box left="-30" top="20" width="160" height="24" background="#2050c0">
      <tween at="0.5" duration="1" from-y="0" to-y="60"/>
    </box>
    <box left="0" top="0" width="30" height="30" background="#208040"/>
  </box>
  <box left="140" top="30" width="70" height="120" background="#f0e8d8" border="4 #c02020" border-radius="24" overflow="visible">
    <box left="-15" top="50" width="100" height="24" background="#2050c0"/>
    <box left="0" top="0" width="30" height="30" background="#208040"/>
  </box>
  <box left="230" top="30" width="80" height="120" background="#f0e8d8" border-radius="12" overflow="hidden">
    <box left="10" top="20" width="60" height="60" background="#e0a020" border-radius="30" overflow="hidden">
      <box left="-20" top="25" width="100" height="10" background="#2050c0"/>
    </box>
    <box left="-10" top="100" width="100" height="10" background="#208040"/>
  </box>
</composition>
