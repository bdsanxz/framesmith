<?xml version="1.0" encoding="UTF-8"?>
<!-- Four texts in black at 24 units of font size, each a bar, three equal figures, and a bar: 111 and 888 with tabular
     figures on the first two lines, and with proportional figures on the last two. The width of each text, from the
     left edge of its first bar to the right edge of its last, is what the test measures. 200 by 160 pixels, 10 frames a
     second. -->
<composition version="1" id="text-figure-widths" width="200" height="160" fps="10" duration="1" background="#ffffff">
  <font src="fonts/framesmith-test-stroke-400.ttf" family="Framesmith Test Stroke"/>
  <text left="10" top="8" font-family="Framesmith Test Stroke" font-size="24" color="#000000" font-variant-numeric="tabular-nums">|111|</text>
  <text left="10" top="44" font-family="Framesmith Test Stroke" font-size="24" color="#000000" font-variant-numeric="tabular-nums">|888|</text>
  <text left="10" top="80" font-family="Framesmith Test Stroke" font-size="24" color="#000000" font-variant-numeric="proportional-nums">|111|</text>
  <text left="10" top="116" font-family="Framesmith Test Stroke" font-size="24" color="#000000" font-variant-numeric="proportional-nums">|888|</text>
</composition>
