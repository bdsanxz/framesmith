composition name="main" root=true width=64 height=64 duration=3 background="#101010" version=1 {
  grade preset="teal-orange" contrast=0.2 saturation=0.3 {
    wheel shadows=0.15 midtones=0.1 highlights=-0.1
    curve red="0,0 0.5,0.6 1,1" master="0,0 1,1"
    hsl hue-min=330 hue-max=30 saturation=0.2 lightness=0.2
    lut src="tune.cube" amount=0.5
  }
  box x=4 y=20 width=20 height=24 fill="#c86432" start=0 duration=2 id="a" {
    grade {
      wheel shadows=0.2 midtones=0.1 highlights=-0.1
      curve red="0,0 0.5,0.6 1,1"
      hsl hue-min=330 hue-max=30 saturation=0.2 lightness=0.2
      vignette amount=0.5 softness=0.5
      grain amount=0.3 size=1 seed=7
    }
    effect preset="grayscale"
    effect preset="sepia" amount=0.8
    vfx {
      noise amount=0.6 seed=7
      warp grid=8 strength=4
      displacement scale=4
    }
  }
  box x=0 y=0 width=64 height=64 fill="#0000ff" start=2 duration=1 id="b"
  box x=44 y=44 width=16 height=16 fill="#c86432" start=2 duration=1 {
    grade {
      lut src="baked.cube" amount=1
    }
  }
  tween target=0 property="x" kind="to" start=0 duration=0.5 to=40 ease="linear"
  transition from="a" to="b" duration=0.5 kind="fade"
  motion-blur shutter=360 samples=8 tier="high"
}
